			}
		},
		{
			"scope": "support.other.variable",
			"settings": {
				"foreground": "#CBCDD2"
			}
		},
		{
			"scope": "invalid",
			"settings": {
				"foreground": "#6DBDFA",
				"fontStyle": " italic bold underline"
			}
		},
		{
			"scope": "invalid.deprecated",
			"settings": {
				"foreground": "#6DBDFA",
				"fontStyle": " bold italic underline"
			}
