			"settings": {
				"foreground": "#7FDBCA"
			}
		},
		{
			"scope": [
				"variable.other.readwrite.js",
				"variable.parameter"
			],
			"settings": {
				"foreground": "#D7DBE0"
			}
		},
		{
			"scope": "string.template meta.template.expression",
			"settings": {
				"foreground": "#C63ED3"
			}
		},
		{
			"scope": "string.template punctuation.definition.string",
			"settings": {
				"foreground": "#FFFFFF"
			}
		},
		{
			"scope": "storage",
			"settings": {
				"foreground": "#6DBDFA",
				"fontStyle": ""
			}
		},
		{
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier",
				"variable.language.this"
			],
			"settings": {
				"foreground": "#00BFF9",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword.operator"
			],
			"settings": {
				"foreground": "#00BFF9",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"storage",
				"meta.var.expr",
				"meta.class meta.method.declaration meta.var.expr storage.type.js",
				"storage.type.property.js",
				"storage.type.property.ts"
			],
			"settings": {
				"foreground": "#C792EA",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"variable.other.meta.import.js",
				"meta.import.js variable.other",
				"variable.other.meta.export.js",
				"meta.export.js variable.other"
			],
			"settings": {
				"foreground": "#D3EED6"
			}
