			"settings": {
				"foreground": "#F7ECB5",
				"fontStyle": ""
			}
		},
		{
			"scope": "support.variable.property",
			"settings": {
				"foreground": "#7FDBCA"
			}
		},
		{
			"scope": "entity.name.function",
			"settings": {
				"foreground": "#87AFF4",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "variable.parameter",
			"settings": {
				"foreground": "#D7DBE0",
				"fontStyle": ""
			}
		},
		{
			"scope": "entity.name.tag",
			"settings": {
